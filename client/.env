# SQLite（マイグレーション・起動時の cwd は client ディレクトリ）
DATABASE_URL=file:./prisma/dev.db

# JWT（本番では必ず変更）
# JWT_SECRET=

# 本番: フロントのオリジン（カンマ区切り）。Socket.IO の CORS に使用
# CLIENT_ORIGIN=https://example.com

# 別ホストに API だけ置く場合のみ
# NEXT_PUBLIC_API_URL=https://api.example.com

# スマホなど LAN の IP で http://192.168.x.x:3000 から開くときの Next 警告を抑える（カンマ区切り）
# NEXT_ALLOWED_DEV_ORIGINS=http://192.168.10.49:3000
