// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum TournamentStatus {
  READY
  RUNNING
  FINISHED
}

enum MatchStatus {
  READY
  RUNNING
  FINISHED
}

model User {
  id              Int                  @id @default(autoincrement())
  email           String               @unique
  password        String
}

model Tournament {
  id               Int                  @id @default(autoincrement())
  name             String
  adminPasscode    String               @unique
  eventDate        String?
  timeSlot         String?
  courtCount       Int                  @default(2)
  status           TournamentStatus     @default(READY)
  observerPasscode String?
  matches          Match[]
  participants     Participant[]
}

model Match {
  id           Int         @id @default(autoincrement())
  tournamentId Int
  round        Int
  position     Int
  player1Id    Int?
  player2Id    Int?
  winnerId     Int?
  status       MatchStatus @default(READY)
  courtNumber  Int?
  nextMatchId  Int?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  nextMatch  Match?     @relation("MatchNext", fields: [nextMatchId], references: [id], onDelete: SetNull)
  feeders    Match[]    @relation("MatchNext")

  @@unique([tournamentId, round, position])
}

model Participant {
  id           Int      @id @default(autoincrement())
  tournamentId Int
  name         String
  initialPosition Int?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, initialPosition])
  @@index([tournamentId])
}
